%% Sequence - TPS Internal Transfer
sequenceDiagram
  autonumber
  participant CustomerApp
  participant AuthAPI
  participant TPS
  participant AccountSvc
  participant LedgerSvc
  participant NotifySvc
  CustomerApp->>AuthAPI: 1. Intake - capture
  AuthAPI->>TPS: 2. Intake - validate
  TPS->>AccountSvc: 3. Intake - enrich
  AccountSvc->>LedgerSvc: 4. Intake - execute
  LedgerSvc->>NotifySvc: 5. Intake - record
  NotifySvc-->>CustomerApp: 6. Authentication - capture
  CustomerApp->>AuthAPI: 7. Authentication - validate
  AuthAPI->>TPS: 8. Authentication - enrich
  alt Gate approved
    TPS->>AuthAPI: proceed
  else Gate rejected
    TPS-->>AuthAPI: rework required
  end
  TPS->>AccountSvc: 9. Authentication - execute
  AccountSvc->>LedgerSvc: 10. Authentication - record
  LedgerSvc->>NotifySvc: 11. Validation - capture
  NotifySvc-->>CustomerApp: 12. Validation - validate
  loop Retry up to 3 attempts
    NotifySvc->>CustomerApp: retry request
  end
  CustomerApp->>AuthAPI: 13. Validation - enrich
  AuthAPI->>TPS: 14. Validation - execute
  TPS->>AccountSvc: 15. Validation - record
  AccountSvc->>LedgerSvc: 16. Policy - capture
  alt Gate approved
    LedgerSvc->>AccountSvc: proceed
  else Gate rejected
    LedgerSvc-->>AccountSvc: rework required
  end
  LedgerSvc->>NotifySvc: 17. Policy - validate
  NotifySvc-->>CustomerApp: 18. Policy - enrich
  CustomerApp->>AuthAPI: 19. Policy - execute
  AuthAPI->>TPS: 20. Policy - record
  TPS->>AccountSvc: 21. Execution - capture
  AccountSvc->>LedgerSvc: 22. Execution - validate
  LedgerSvc->>NotifySvc: 23. Execution - enrich
  NotifySvc-->>CustomerApp: 24. Execution - execute
  alt Gate approved
    CustomerApp->>NotifySvc: proceed
  else Gate rejected
    CustomerApp-->>NotifySvc: rework required
  end
  CustomerApp->>AuthAPI: 25. Execution - record
  AuthAPI->>TPS: 26. Notification - capture
  TPS->>AccountSvc: 27. Notification - validate
  AccountSvc->>LedgerSvc: 28. Notification - enrich
  loop Retry up to 3 attempts
    AccountSvc->>LedgerSvc: retry request
  end
  LedgerSvc->>NotifySvc: 29. Notification - execute
  NotifySvc-->>CustomerApp: 30. Notification - record
  CustomerApp->>AuthAPI: 31. Reconciliation - capture
  AuthAPI->>TPS: 32. Reconciliation - validate
  alt Gate approved
    TPS->>AuthAPI: proceed
  else Gate rejected
    TPS-->>AuthAPI: rework required
  end
  TPS->>AccountSvc: 33. Reconciliation - enrich
  AccountSvc->>LedgerSvc: 34. Reconciliation - execute
  par Notify channels
    LedgerSvc->>CustomerApp: app notice
  and
    LedgerSvc->>NotifySvc: email/SMS notice
  end
  LedgerSvc->>NotifySvc: 35. Reconciliation - record
  NotifySvc-->>CustomerApp: 36. Exception - capture
  CustomerApp->>AuthAPI: 37. Exception - validate
  AuthAPI->>TPS: 38. Exception - enrich
  TPS->>AccountSvc: 39. Exception - execute
  AccountSvc->>LedgerSvc: 40. Exception - record
  alt Gate approved
    LedgerSvc->>AccountSvc: proceed
  else Gate rejected
    LedgerSvc-->>AccountSvc: rework required
  end
  LedgerSvc->>NotifySvc: 41. Closure - capture
  NotifySvc-->>CustomerApp: 42. Closure - validate
  CustomerApp->>AuthAPI: 43. Closure - enrich
  AuthAPI->>TPS: 44. Closure - execute
  TPS->>AccountSvc: 45. Closure - record
