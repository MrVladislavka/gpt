%% Collaboration 04: Loan Processing Underwriting
flowchart LR
  ApplicantPortal["Applicant Portal"]
  LoanAPI["Loan API"]
  Rules["Rules Engine"]
  CreditBureau["Credit Bureau"]
  Underwriting["Underwriting Workbench"]
  DocSvc["Document Service"]
  NotifySvc["Notification Service"]

  ApplicantPortal -->|submit loan application| LoanAPI
  LoanAPI -->|store application documents| DocSvc
  DocSvc -->|document ingest status| LoanAPI
  LoanAPI -->|pull bureau report| CreditBureau
  CreditBureau -->|credit report and score| LoanAPI
  LoanAPI -->|evaluate policy thresholds| Rules
  Rules -->|eligibility recommendation| LoanAPI
  LoanAPI -->|route case for review| Underwriting
  Underwriting -->|underwriting decision| LoanAPI
  LoanAPI -->|send decision outcome| NotifySvc
  NotifySvc -.->|decision notification| ApplicantPortal
