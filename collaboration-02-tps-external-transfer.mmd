%% Collaboration 02: TPS External Transfer
flowchart LR
  CustomerApp["Customer App"]
  AuthAPI["Auth API"]
  TPS["TPS Orchestrator"]
  Gateway["Payments Gateway"]
  ExtNetwork["External Network"]
  Compliance["Compliance Engine"]
  NotifySvc["Notification Service"]

  CustomerApp -->|submit external transfer| AuthAPI
  AuthAPI -->|authorized transfer request| TPS
  TPS -->|run sanctions/AML screen| Compliance
  Compliance -->|screening decision| TPS
  TPS -->|send payment instruction| Gateway
  Gateway -->|route instruction| ExtNetwork
  ExtNetwork -->|settlement response| Gateway
  Gateway -->|network response| TPS
  TPS -->|final outcome event| NotifySvc
  NotifySvc -.->|notify customer| CustomerApp
